<mxCell id="t_s02" value="&lt;div style='font-size:20px;color:#06682f;text-align:center'&gt;&lt;b&gt;respuesta_s02 - Acceso y movilización&lt;/b&gt;&lt;/div&gt;&lt;table style='width:100%;border-collapse:collapse;font-size:13px;margin-top:7px'&gt;&lt;tr style='background:#073e76;color:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;Variable&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;Formato&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;Restricción / uso&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;id_respuesta_s02&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;bigserial&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Llave de respuesta.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5fbff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;id_formulario&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;uuid único&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Una respuesta por matriz.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am01&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;varchar(150)&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Frontera. Texto obligatorio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5fbff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am02&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;bigint catálogo&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Medio de movilización.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am03&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;bigint catálogo&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Frecuencia de transporte público.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5fbff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am04&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;numeric(6,2)&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Tiempo en horas. No negativo.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am05&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;varchar(150)&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Categoría de accesibilidad.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5fbff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;s02_am06&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;bigint catálogo&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Tipo de vía.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffffff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;creado_en&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;timestamp tz&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Creación.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5fbff'&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;&lt;b&gt;actualizado_en&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;timestamp tz&lt;/td&gt;&lt;td style='border:1px solid #bcd5e8;padding:5px'&gt;Actualización.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=none;strokeColor=none;strokeWidth=0;fontFamily=Century Gothic;spacing=0;" vertex="1" parent="1"><mxGeometry x="1975" y="1235" width="1690" height="400" as="geometry" /></mxCell>
